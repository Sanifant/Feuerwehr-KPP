<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="using:de.openelp.feuerwehr.domain"
             xmlns:vm="using:de.openelp.feuerwehr.desktop.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="de.openelp.feuerwehr.desktop.Views.InventoryView">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:InventoryViewModel/>
    </Design.DataContext>

     <StackPanel Margin="10">
         <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button Content="+ Add Item"
                    x:DataType="vm:InventoryViewModel"
                    Command="{Binding AddItem}"
                    Margin="5"/>
            <Button Content="Refresh"
                    x:DataType="vm:InventoryViewModel"
                    Margin="5" 
                    Command="{Binding LoadItems}"/>
            </StackPanel>

        <!-- Inventory Table -->
        <DataGrid Grid.Row="1"
                    Margin="10"
                    Height="300"
                    BorderBrush="Gray"
                    AutoGenerateColumns="False"
                    x:DataType="vm:InventoryViewModel"
                    SelectedItem="{Binding SelectedItem}"
                    ItemsSource="{Binding Items}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" x:DataType="domain:InventoryItem"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" x:DataType="domain:InventoryItem"/>
                <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*" x:DataType="domain:InventoryItem"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" x:DataType="domain:InventoryItem"/>
                <DataGridTextColumn Header="Next Inspection" Binding="{Binding NextInspectionDate}" Width="*" x:DataType="domain:InventoryItem"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- Bottom Section -->
        <Grid ColumnDefinitions="300,*" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="10" VerticalAlignment="Bottom">
            

    
            <TextBlock Text="Selected Item Details"
                Grid.ColumnSpan="2"
                Grid.Row="0"
                FontWeight="Bold"
                FontSize="16"
                Margin="0,0,0,10"/>

            <TextBox Grid.Column="0" Grid.Row="1">Name</TextBox>
            <TextBox Grid.Column="1" Grid.Row="1" x:DataType="vm:InventoryViewModel" Text="{Binding SelectedItem.Name}"/>
            <TextBox Grid.Column="0" Grid.Row="2">Category</TextBox>
            <TextBox Grid.Column="1" Grid.Row="2" x:DataType="vm:InventoryViewModel" Text="{Binding SelectedItem.Category}"/>
            <TextBox Grid.Column="0" Grid.Row="3">Quantity</TextBox>
            <TextBox Grid.Column="1" Grid.Row="3" x:DataType="vm:InventoryViewModel" Text="{Binding SelectedItem.Quantity}"/>
            <TextBox Grid.Column="0" Grid.Row="4">Condition</TextBox>
            <TextBox Grid.Column="1" Grid.Row="4" x:DataType="vm:InventoryViewModel" Text="{Binding SelectedItem.Condition}"/>
            <TextBox Grid.Column="0" Grid.Row="5">Location</TextBox>
            <TextBox Grid.Column="1" Grid.Row="5" x:DataType="vm:InventoryViewModel" Text="{Binding SelectedItem.Location}"/>


        </Grid>

    </StackPanel>
</UserControl>
