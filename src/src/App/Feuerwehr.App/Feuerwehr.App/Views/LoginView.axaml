<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Feuerwehr.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Feuerwehr.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <Grid Background="#F5F5F5">
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#DC143C" Offset="0.0" />
                    <GradientStop Color="#B22222" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border MaxWidth="450" MaxHeight="600" Background="White" CornerRadius="8" BoxShadow="0 4 20 4 #40000000" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20">
                <Image Source="/Assets/logoFeuerwehr.png" Width="120" Height="120" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="Feuerwehr App" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#DC143C" />
                <TextBlock Text="Bitte melden Sie sich an" FontSize="16" HorizontalAlignment="Center" Foreground="#666666" Margin="0,0,0,20" />
                <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1" CornerRadius="4" Padding="12">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" />
                </Border>
                <StackPanel Spacing="8">
                    <TextBlock Text="E-Mail" FontWeight="SemiBold" Foreground="#333333" />
                    <TextBox Text="{Binding Email}" Watermark="ihre.email@feuerwehr.de" IsEnabled="{Binding !IsLoggingIn}" Height="40" Padding="12,8" CornerRadius="4" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Passwort" FontWeight="SemiBold" Foreground="#333333" />
                    <TextBox Text="{Binding Password}" Watermark="Passwort eingeben" PasswordChar="●" IsEnabled="{Binding !IsLoggingIn}" Height="40" Padding="12,8" CornerRadius="4" />
                </StackPanel>
                <CheckBox IsChecked="{Binding RememberMe}" Content="Angemeldet bleiben" IsEnabled="{Binding !IsLoggingIn}" Foreground="#666666" />
                <Button Command="{Binding LoginCommand}" IsEnabled="{Binding !IsLoggingIn}" Height="45" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4" Background="#DC143C" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0">
                    <Panel>
                        <TextBlock Text="Anmelden..." IsVisible="{Binding IsLoggingIn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="Anmelden" IsVisible="{Binding !IsLoggingIn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Button>
                <TextBlock Text="Version 1.0.0" FontSize="12" Foreground="#999999" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
