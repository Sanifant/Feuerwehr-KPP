<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <RootNamespace>De.Openelp.Feuerwehr.App.iOS</RootNamespace>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<!-- macOS: echtes iOS-Projekt -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<TargetFramework>net10.0-ios</TargetFramework>
		<SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<Compile Include="Main.cs;AppDelegate.cs;Services/IosBarcodeScanner.cs" />
		<PackageReference Include="Avalonia.iOS" />
	</ItemGroup>

	<!-- Windows/Linux: Dummy -->
	<PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
		<Compile Include="DummyMain.cs" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="StyleCop.Analyzers">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Feuerwehr.App\Feuerwehr.App.csproj" />
  </ItemGroup>

</Project>
