// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet-postgres
{
    "name": "C# (.NET) and PostgreSQL",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"containerEnv": {
		"JDK_VERSION" : "17",
		"ANDROID_SDK_VERSION" : "11076708"
	},
	"remoteEnv": {
		"ANDROID_SDK_ROOT": "/home/vscode/android-sdk"
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [5000, 5001, 5432, 5050, 5540],
	"portsAttributes": {
		"5001": {
			"protocol": "https"
		}		
	},

	"postCreateCommand": "dotnet --info && dotnet restore src/de.openelp.feuerwehr.slnx",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csharp",
                "ms-dotnettools.vscode-dotnet-runtime",
                "AvaloniaTeam.vscode-avalonia",
                "MS-CEINTL.vscode-language-pack-de",
                "ms-ossdata.vscode-pgsql",
                "ms-dotnettools.csdevkit",
                "Redis.redis-for-vscode"
            ]
        }
    }
}
