# Beispielkonfiguration für das Feuerwehr-Backend.
# ASP.NET Core liest Umgebungsvariablen automatisch ein. Verschachtelte
# Konfigurationsschlüssel werden mit doppeltem Unterstrich geschrieben (A:B -> A__B).
# Diese Datei wird nicht automatisch geladen: Werte in die Laufzeitumgebung
# übernehmen oder die Datei lokal nach .env kopieren und mit einem passenden Loader laden.

# -----------------------------------------------------------------------------
# Laufzeit und HTTP-Server
# -----------------------------------------------------------------------------
# ASP.NET Core-Umgebung. Production aktiviert unter anderem die Origin-Prüfung
# über AllowedOrigins. Für lokale Entwicklung auf Development setzen.
ASPNETCORE_ENVIRONMENT=Production

# Listen-Adresse des Servers (im Container standardmäßig Port 8080).
ASPNETCORE_URLS=http://+:8080
# Alternative zu ASPNETCORE_URLS: Port-Variablen verwenden, wenn ASPNETCORE_URLS
# nicht gesetzt ist. Das Dockerfile deaktiviert diese beiden Variablen derzeit.
# ASPNETCORE_HTTP_PORTS=8080
# ASPNETCORE_HTTPS_PORTS=8443

# Zulässige Host-Header; * erlaubt alle Hosts. Für Produktion möglichst einschränken.
AllowedHosts=*

# -----------------------------------------------------------------------------
# Datenbank, Cache und E-Mail-Verbindung
# -----------------------------------------------------------------------------
# Verbindungszeichenfolge des Backend-Datenbank-Kontexts (Aspire: postgresdb).
# Außerhalb von Aspire auf die erreichbare PostgreSQL-Instanz anpassen.
ConnectionStrings__postgresdb=Host=localhost;Port=5432;Database=feuerwehr;Username=feuerwehr;Password=CHANGE_ME

# Redis-Verbindung des Aspire-Cache-Clients. Außerhalb von Aspire auf den Redis-Host setzen.
ConnectionStrings__cache=localhost:6379

# SMTP-Provider, z. B. ein STRATO-Postfach (Port 465 mit SSL/TLS).
# Zugangsdaten des Postfachs verwenden; keine echten Kennwoerter versionieren.
MAIL_HOST=smtp.strato.de
MAIL_PORT=465
# SslOnConnect = sofort TLS; StartTls = verpflichtendes STARTTLS (typisch Port 587).
# None ist fuer lokales Mailpit ohne Anmeldung vorgesehen.
MAIL_SECURITY=SslOnConnect
MAIL_USERNAME=noreply@example.org
MAIL_PASSWORD=replace-with-mailbox-password
MAIL_FROM=noreply@example.org
MAIL_FROM_NAME=Feuerwehr
MAIL_TIMEOUT_SECONDS=30
# Der lokale Aspire-AppHost verwendet weiterhin Mailpit und ignoriert die obigen Providerwerte.
# Mail__From bleibt als alter Absender-Schluessel kompatibel; MAIL_FROM hat Vorrang.

# -----------------------------------------------------------------------------
# Initialer Administrator
# -----------------------------------------------------------------------------
# E-Mail des initialen Administrators; wird nur zur Erstellung benutzt, falls
# dieses Konto noch nicht existiert. Der Default im Backend ist admin@feuerwehr.local.
SeedAdmin__Email=admin@example.org

# Sicheres, individuelles Passwort für den initialen Administrator. Beim ersten
# Start erforderlich, wenn das Konto noch nicht existiert; Identity verlangt
# mindestens 8 Zeichen sowie Groß-/Kleinbuchstaben und eine Ziffer.
SeedAdmin__Password=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD

# -----------------------------------------------------------------------------
# JWT-Authentifizierung
# -----------------------------------------------------------------------------
# Geheimer Signaturschlüssel. Für jede Umgebung zufällig erzeugen, sicher speichern
# und mindestens 32 Zeichen lang wählen. Nie den Entwicklungswert aus AppHost nutzen.
JwtSettings__SecretKey=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Issuer und Audience müssen zum ausstellenden Backend und den Clients passen.
JwtSettings__Issuer=FeuerwehrAPI
JwtSettings__Audience=FeuerwehrClients

# Lebensdauer von Access Tokens in Minuten.
JwtSettings__AccessTokenExpirationMinutes=15

# Hinweis: JwtSettings:RefreshTokenExpirationDays steht zwar in appsettings.json,
# wird aktuell aber vom Backend-Code nicht gelesen und hat daher keine Wirkung.

# -----------------------------------------------------------------------------
# Frontend-Zugriff und Einladungslinks
# -----------------------------------------------------------------------------
# Basis-URL des Frontends; wird zum Erzeugen von Passwort-Einladungslinks verwendet.
Frontend__BaseUrl=https://example.org

# Erlaubte Browser-Origins im Nicht-Development-Betrieb. Bei mehreren Origins
# fortlaufende numerische Indizes verwenden (AllowedOrigins__1, __2, ...).
AllowedOrigins__0=https://example.org

# -----------------------------------------------------------------------------
# Logging und Telemetrie
# -----------------------------------------------------------------------------
# ASP.NET Core Logging-Filter; mögliche Werte sind z. B. Trace, Debug, Information,
# Warning, Error, Critical oder None.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Optional: aktiviert den OpenTelemetry-OTLP-Exporter, wenn ein Endpoint gesetzt ist.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# Aspire-Hinweise
# -----------------------------------------------------------------------------
# Aspire erzeugt/übergibt normalerweise ConnectionStrings__postgresdb,
# ConnectionStrings__cache und ConnectionStrings__mail automatisch.
# Beim Start über src/Feuerwehr.AppHost wird JwtSettings__SecretKey derzeit im
# AppHost hart kodiert übergeben und überschreibt somit einen hier gesetzten Wert.
# Für einen produktiven AppHost muss dieser Parameter dort ebenfalls aus einer
# sicheren Konfiguration bzw. einem Secret stammen.
